{
  "name": "mouzika-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Mouzika Studio — the modern, interactive way to learn electronic music production.",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
