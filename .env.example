# ============================================================================
# Mouzika Studio — environment configuration
# Copy to `.env.local` and fill in. Every value is OPTIONAL: the app runs fully
# offline with localStorage persistence and a rule-based tutor. Configure these
# to enable the cloud/AI features.
# ============================================================================

# --- AI Tutor (server-side, never exposed to the browser) -------------------
# When set, /api/tutor calls the Anthropic Messages API. Without it, the tutor
# gracefully falls back to the built-in rule-based responses.
ANTHROPIC_API_KEY=
# Optional model override (defaults to a fast Haiku model).
MOUZIKA_TUTOR_MODEL=claude-haiku-4-5-20251001

# --- Supabase (optional: accounts, cross-device progress, community) --------
# The progress store (src/lib/store) is written behind an interface so it can
# be backed by Supabase instead of localStorage. See supabase/schema.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key for admin/content-engine writes. NEVER prefix with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (optional: paid plans) ------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
